{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(npm test)",
      "PowerShell(npm run test:month)",
      "PowerShell(npm run test:live)",
      "PowerShell(npm ci)",
      "PowerShell(.\\scripts\\monatscheck.ps1:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(gh auth status)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr checks:*)",
      "Bash(npm test)",
      "Bash(npm run test:month)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "PowerShell(git push:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr edit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)"
    ],
    "deny": [
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./cloudflare/.dev.vars)",
      "Read(./.dev.vars)"
    ]
  }
}
